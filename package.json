{
  "name": "repohistory",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --port 3474",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:file": "prettier --write",
    "check": ".claude/hooks/check-all.sh --force",
    "lint:file": "eslint --max-warnings 0 --no-warn-ignored",
    "knip": "knip --no-progress --reporter compact",
    "dupes": "jscpd app lib --threshold 0 --reporters console",
    "test": "vitest run --passWithNoTests",
    "verify": ".githooks/verify.sh",
    "prepare": "git config core.hooksPath .githooks",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime=false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply repohistory --local",
    "db:migrate:remote": "wrangler d1 migrations apply repohistory --remote",
    "secrets:push": "node scripts/push-secrets.mjs"
  },
  "dependencies": {
    "@next/env": "^15.3.5",
    "@opennextjs/cloudflare": "^1.20.16",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.4",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.15",
    "lodash": "^4.17.21",
    "lucide-react": "^0.522.0",
    "motion": "^12.23.3",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.6",
    "svgo": "^3.3.2",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/cli": "^0.1.24",
    "@playwright/test": "^1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jscpd": "^5.4.3",
    "jsdom": "^26.1.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^14.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
