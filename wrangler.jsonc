{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repohistory",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "repohistory",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "repohistory",
      "database_id": "3c814859-c12c-4e6a-8fb6-da87583935c8",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "13390fc6144a4c5d964a7a6b267c1396",
    },
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "repohistory.dvasyliev.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
}
